{
  "name": "prettytap",
  "version": "0.1.3",
  "description": "Pretty-print TAP results.",
  "main": "index.js",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "bin": {
    "prettytap": "bin.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin.js",
    "lib"
  ],
  "dependencies": {
    "paparam": "1.13.0"
  },
  "devDependencies": {
    "brittle": "4.1.0",
    "lunte": "1.8.4",
    "prettier": "3.9.6",
    "prettier-config-holepunch": "2.0.0"
  },
  "scripts": {
    "format": "prettier . --write",
    "demo": "node examples/demo.js | node bin.js",
    "demo:pass": "node examples/demo-pass.js | node bin.js",
    "demo:json": "node examples/demo.js | node bin.js -f json",
    "demo:bail": "node bin.js < test/fixtures/example.txt",
    "demo:self": "npm run test:node | node bin.js",
    "demo:chain": "npm run demo:pass && npm run demo:bail",
    "test:pretty": "npm run test:node:pretty && npm run test:bare:pretty",
    "test:node:pretty": "brittle-node test/all.mjs | node bin.js",
    "test:bare:pretty": "brittle-bare test/all.mjs | node bin.js",
    "test": "npm run test:node && npm run test:bare",
    "test:node": "brittle-node test/all.mjs",
    "test:bare": "brittle-bare test/all.mjs",
    "test:generate": "brittle-make-test test/all.mjs test/*.js",
    "lint": "prettier . --check && lunte"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetherto/prettytap.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tetherto/prettytap/issues"
  },
  "homepage": "https://github.com/tetherto/prettytap"
}
